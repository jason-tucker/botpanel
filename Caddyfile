# Botpanel ingress. Phase 0: serves the static landing page only.
# MVP: this Caddyfile flips on a reverse_proxy block to the Next.js container,
# falling back to the landing on 5xx so the user always sees something useful.
#
# Listens on :{$PORT:6080} INSIDE the docker network. No host port mapping —
# Cloudflare Tunnel reaches us over the docker network.
{
  # Auto-HTTPS off — Cloudflare terminates TLS at the edge.
  auto_https off
  # Keep admin API off too; we don't run `caddy reload` from inside the container.
  admin off
}

:{$PORT:6080} {
  encode gzip zstd

  # Path-based dev routing: bots.tucker.host/dev/* gets the prefix stripped
  # so the same Caddy serves both prod (at root) and the dev clone (at /dev/).
  # No-op when no /dev prefix is present.
  uri strip_prefix /dev

  # Reverse-proxy to Next.js when it's up. If Next is down or returning 5xx,
  # handle_errors below falls back to landing/502.html so the page is ALWAYS
  # something useful — never a Cloudflare error or a blank screen.
  handle_errors {
    @5xx expression `{err.status_code} >= 500`
    handle @5xx {
      root * /srv/landing
      rewrite * /502.html
      file_server
    }
  }

  reverse_proxy next:3000 {
    # If Next.js is not yet up (Phase 0 → MVP transition), Caddy
    # automatically falls back to the error handler above.
    fail_duration 5s
    max_fails 2
    lb_try_duration 2s
  }
}

# ──────────────────────────────────────────────────────────────────────────
# When Next.js lands (MVP), replace the block above with this one:
