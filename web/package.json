{
  "name": "botpanel-web",
  "version": "0.4.1",
  "description": "Web control panel for the Squishy & Otter Discord bots",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "sync:schemas": "bash ../scripts/sync-schema.sh",
    "verify:schemas": "bash ../scripts/sync-schema.sh && git diff --exit-code -- src/lib/db/schema || (echo '❌ Schemas drifted — re-run pnpm sync:schemas and commit' && exit 1)"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "jose": "^5.9.6",
    "lucide-react": "^1.20.0",
    "next": "^15.0.3",
    "postgres": "^3.4.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.14",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
