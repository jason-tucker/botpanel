{
  "name": "botpanel-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "sync:schemas": "bash ../scripts/sync-schema.sh",
    "verify:schemas": "bash ../scripts/sync-schema.sh && git diff --exit-code -- src/lib/db/schema || (echo '❌ Schemas drifted — re-run pnpm sync:schemas and commit' && exit 1)"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.460.0",
    "next": "^15.0.3",
    "postgres": "^3.4.5",
    "react": "^19.0.0-rc-66855b96-20241106",
    "react-dom": "^19.0.0-rc-66855b96-20241106",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
