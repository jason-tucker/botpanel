# ───────────────────────────────────────────────────────────────────
# Botpanel environment — copy to .env and fill in
# ───────────────────────────────────────────────────────────────────

# Which floating image tag this clone pulls from GHCR. Watchtower polls every
# 30s and restarts the caddy container when the tag's digest changes.
#   Production clone (main branch) → :latest
#   Dev clone        (dev branch)  → :dev
BOT_IMAGE=ghcr.io/jason-tucker/botpanel:latest

# Internal port Caddy listens on (also bound to 127.0.0.1 on the host so
# cloudflared can reach it).
#   Production clone → 6080
#   Dev clone        → 6081
PORT=6080

# Per-clone compose project name so prod and dev containers don't collide.
# Defaults to the dir name; override for safety.
COMPOSE_PROJECT_NAME=botpanel

# ─── Cloudflare Tunnel ─────────────────────────────────────────────
# Create one at https://one.dash.cloudflare.com/ → Zero Trust → Networks → Tunnels.
# Pick "Cloudflared" → copy the token from the "Run" tab.
# Public hostname routing should point at  http://caddy:6080
CF_TUNNEL_TOKEN=

# ─── Build metadata (set by CI, harmless locally) ──────────────────
GIT_SHA=dev
BUILD_TIME=unknown

# ─── MVP and beyond will add: ──────────────────────────────────────
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# SESSION_SECRET=
# BOT_OWNER_ID=117501528641634310
# SQUISHY_DATABASE_URL=postgresql://squishybot:PASSWORD@db-squishy:5432/squishybot
# OTTER_DATABASE_URL=postgresql://otterbot:PASSWORD@db-otter:5432/otterbot
# REDIS_URL=redis://redis:6379
# BOTPANEL_RPC_SECRET=
# PUBLIC_BASE_URL=https://botpanel.example.com
