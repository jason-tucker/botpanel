# ───────────────────────────────────────────────────────────────────
# Botpanel environment — copy to .env and fill in
# ───────────────────────────────────────────────────────────────────

# Which floating image tags this clone pulls from GHCR. Watchtower polls every
# 30s and restarts containers when their tag's digest changes.
#   Production clone (main branch) → :latest
#   Dev clone        (dev branch)  → :dev
BOT_IMAGE=ghcr.io/jason-tucker/botpanel:latest
NEXT_IMAGE=ghcr.io/jason-tucker/botpanel-web:latest

# Internal port Caddy listens on (also bound to 127.0.0.1 on the host so
# cloudflared can reach it).
#   Production clone → 6080
#   Dev clone        → 6081
PORT=6080

# Per-clone compose project name so prod and dev containers don't collide.
# Defaults to the dir name; override for safety.
COMPOSE_PROJECT_NAME=botpanel

# Per-clone DNS alias for the Next.js service on the shared botpanel-net.
# Prod stack uses `next-prod`, dev stack uses `next-dev`. The Caddyfile
# reads $NEXT_HOST so each clone's Caddy reverse-proxies to its own next.
# Default is `next-prod` (matches the main-stack expectation).
NEXT_ALIAS=next-prod
NEXT_HOST=next-prod

# ─── Cloudflare Tunnel ─────────────────────────────────────────────
# cloudflared runs as a STANDALONE docker container outside this compose
# stack (see the "cloudflared is intentionally NOT a compose service"
# comment block in docker-compose.yml for the `docker run` command).
# Its TUNNEL_TOKEN lives in /home/botuser/cloudflared/.env (chmod 600),
# so it is NOT set here.
#
# Cloudflare ingress rules should point at `http://localhost:6080`
# (the standalone cloudflared uses --network host, so localhost = the VPS).

# ─── Build metadata (set by CI, harmless locally) ──────────────────
GIT_SHA=dev
BUILD_TIME=unknown

# ─── Next.js / dashboard (foundation lands now; full MVP fills these in) ──
# Set these to flip the dashboard on. Without them the landing page stays
# the homepage and `/api/auth/login` 503s.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 64+ random bytes — `openssl rand -base64 48`
SESSION_SECRET=
BOT_OWNER_ID=117501528641634310
# Public origin Cloudflare Tunnel maps to this clone. Cookie domain and
# OAuth redirect URI derive from this.
PUBLIC_BASE_URL=
# Discord guild the bots run in.
GUILD_ID=

# Shared bus (Redis) and bot DBs. Reachable on the docker network via the
# aliases the bot compose files set up.
REDIS_URL=redis://redis:6379
SQUISHY_DATABASE_URL=postgresql://squishybot:PASSWORD@db-squishy:5432/squishybot
OTTER_DATABASE_URL=postgresql://otterbot:PASSWORD@db-otter:5432/otterbot

# Shared HMAC for the Redis command bus (panel ↔ bots). Must match
# BOTPANEL_RPC_SECRET on both bots. 64+ random bytes.
BOTPANEL_RPC_SECRET=
